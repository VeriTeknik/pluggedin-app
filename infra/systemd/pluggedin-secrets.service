# Decrypts the stack's secrets into /run/sops and stages Traefik's dynamic
# config there BEFORE dockerd starts.
#
# /run is tmpfs, so a reboot empties /run/sops. Every container has
# restart: always, so dockerd brings the stack back before anyone can run
# deploy.sh: the app, Postgres and Redis exit on their missing secrets, Docker
# leaves empty root-owned directories where the files belong, and Traefik
# starts with no dynamic config and answers 404 to everything.
#
# WantedBy=docker.service (not multi-user.target) means this runs whenever
# dockerd starts, however it was pulled in - including socket activation.
# Before= makes dockerd wait for it. If it fails, dockerd still starts (Wants,
# not Requires): a running stack with a failed decrypt is no worse than the
# old boot, and `deploy.sh` cleans up the stray directories itself.
#
# Install (root):
#   install -m 0644 infra/systemd/pluggedin-secrets.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable pluggedin-secrets.service
#   systemctl start pluggedin-secrets.service   # dry run against the live stack: identical content is not rewritten
#
# /run/sops itself comes from /etc/tmpfiles.d/pluggedin.conf
# (`d /run/sops 0700 pluggedin pluggedin -`), which runs earlier in sysinit.

[Unit]
Description=Decrypt plugged.in secrets into /run/sops before Docker starts
Before=docker.service
After=local-fs.target systemd-tmpfiles-setup.service
ConditionPathExists=/home/pluggedin/pluggedin-app/infra/scripts/deploy.sh

[Service]
Type=oneshot
RemainAfterExit=yes
User=pluggedin
Group=pluggedin
# sops and age are installed per-user, not system-wide.
Environment=PATH=/home/pluggedin/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=SOPS_AGE_KEY_FILE=/etc/sops/age/keys.txt
ExecStart=/home/pluggedin/pluggedin-app/infra/scripts/deploy.sh --prepare-only
TimeoutStartSec=120

[Install]
WantedBy=docker.service
